# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*

# private node toolchain (activate.sh) — never committed
/.node/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env.local
.env.*.local

# firebase emulator artifacts
firebase-debug.log
firestore-debug.log
ui-debug.log
.firebase/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
