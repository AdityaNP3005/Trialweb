# ---------------------------------------------------------------------------
# Public Firebase web-app config for production builds.
#
# These values are NOT secrets: Firebase's web config is delivered to every
# browser and access is enforced by Firestore security rules (see
# firestore.rules). They are committed here on purpose so a production build
# always has them, even when the hosting dashboard has no env vars set.
#
# Values set in the hosting dashboard (e.g. Vercel Environment Variables) take
# precedence over this file. `npm run dev` uses `.env.local` if present.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBvMNe3eS-W_BBIF1bL3lQtpG13XwihOH4
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=goabroad-d86fc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=goabroad-d86fc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=goabroad-d86fc.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=280098969577
NEXT_PUBLIC_FIREBASE_APP_ID=1:280098969577:web:8361366d81b529965bdd78

# Must never be enabled in production.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=
